# Verify Token — valor que voce mesmo cria, tem que bater com o configurado no Meta for Developers
VERIFY_TOKEN=ATIVA_WHATSAPP_WEBHOOK_2026

# App Secret do app Meta (WhatsApp > Configuracao da API > Chave secreta do app)
# usado pra validar assinatura X-Hub-Signature-256 nos POSTs
APP_SECRET=

# Banco MySQL onde mensagens/status sao salvos
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/apiwpp

PORT=8001
